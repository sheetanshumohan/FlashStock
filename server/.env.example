# Application
NODE_ENV=development
PORT=5000

# MongoDB
# Supply your own MongoDB replica-set connection string.
# Transactions require a MongoDB deployment that supports transactions.
MONGO_URI=replace_with_your_mongodb_connection_string

# Leave blank for the database specified by MONGO_URI.
# Uncomment and set only when intentionally overriding the database.
MONGO_DB_NAME=

# Database diagnostics (disabled by default)
MONGO_COMMAND_MONITORING=false
MONGO_POOL_MONITORING=false

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Reservation configuration
RESERVATION_TTL_MS=900000

# Order-processing configuration
ORDER_PROCESSING_LEASE_MS=20000
ORDER_PROCESSING_QUEUE_NAME=flashstock-order-processing

# API rate limiting
PRODUCT_READ_RATE_LIMIT_MAX=120

# Performance diagnostics (disabled by default)
RESERVATION_PERFORMANCE_LOGS=false

# Local development only.
# Verify the controller's payment-mode restrictions before enabling.
PAYMENT_MODE=mock